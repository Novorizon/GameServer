+using System.Net.Security;
+using System.Security.Authentication;
+using System.Security.Cryptography.X509Certificates;
+
+namespace GameServer.Networking.Tcp;
+
+// Benchmark-only overlay. This file is absent from the production TCP project.
+internal sealed class ComparisonTlsTransport : IDisposable
+{
+    private readonly X509Certificate2? _certificate;
+    private readonly SslStreamCertificateContext? _context;
+    private readonly SemaphoreSlim _handshakes = new(128, 128);
+
+    public ComparisonTlsTransport(string? certificatePath)
+    {
+        if (string.IsNullOrEmpty(certificatePath)) return;
+        _certificate = X509CertificateLoader.LoadPkcs12FromFile(certificatePath, null, X509KeyStorageFlags.EphemeralKeySet);
+        if (!_certificate.HasPrivateKey) throw new InvalidOperationException("Missing TLS private key.");
+        _context = SslStreamCertificateContext.Create(_certificate, additionalCertificates: null, offline: true);
+    }
+
+    public ValueTask<Stream> AcceptAsync(Stream network, CancellationToken ct) =>
+        _context == null ? ValueTask.FromResult(network) : AuthenticateAsync(network, ct);
+
+    private async ValueTask<Stream> AuthenticateAsync(Stream network, CancellationToken ct)
+    {
+        if (!_handshakes.Wait(0)) throw new IOException("TLS handshake admission full.");
+        var tls = new SslStream(network, leaveInnerStreamOpen: false);
+        try
+        {
+            using var timeout = CancellationTokenSource.CreateLinkedTokenSource(ct);
+            timeout.CancelAfter(TimeSpan.FromSeconds(5));
+            await tls.AuthenticateAsServerAsync(new SslServerAuthenticationOptions
+            {
+                ServerCertificateContext = _context,
+                EnabledSslProtocols = SslProtocols.Tls13,
+                AllowRenegotiation = false
+            }, timeout.Token);
+            return tls;
+        }
+        catch { await tls.DisposeAsync(); throw; }
+        finally { _handshakes.Release(); }
+    }
+
+    public void Dispose()
+    {
+        if (_context != null)
+            foreach (var certificate in _context.IntermediateCertificates) certificate.Dispose();
+        _certificate?.Dispose();
+        _handshakes.Dispose();
+    }
+}
