@@ -0,0 +1,50 @@
+using System.Net.Security;
+using System.Security.Authentication;
+using System.Security.Cryptography;
+using System.Security.Cryptography.X509Certificates;
+
+namespace GameServer.LoadTests;
+
+// Test certificate is trusted explicitly; certificate validation is enabled.
+internal static class ComparisonTlsClient
+{
+    private static readonly Lazy<X509Certificate2> Root = new(() =>
+        X509CertificateLoader.LoadCertificateFromFile(Environment.GetEnvironmentVariable("TCP_COMPARISON_TLS_ROOT")
+            ?? throw new InvalidOperationException("Missing comparison root certificate.")));
+
+    public static bool Enabled => !string.IsNullOrEmpty(Environment.GetEnvironmentVariable("TCP_COMPARISON_TLS_ROOT"));
+
+    public static async ValueTask<Stream> ConnectAsync(Stream network, bool report, CancellationToken ct)
+    {
+        if (!Enabled) return network;
+        var tls = new SslStream(network, leaveInnerStreamOpen: false);
+        try
+        {
+            var policy = new X509ChainPolicy
+            { TrustMode = X509ChainTrustMode.CustomRootTrust, RevocationMode = X509RevocationMode.NoCheck };
+            policy.CustomTrustStore.Add(Root.Value);
+            await tls.AuthenticateAsClientAsync(new SslClientAuthenticationOptions
+            {
+                TargetHost = "localhost", CertificateChainPolicy = policy,
+                EnabledSslProtocols = SslProtocols.Tls13, AllowRenegotiation = false
+            }, ct);
+            if (report) Console.WriteLine(System.Text.Json.JsonSerializer.Serialize(new
+            { @event = "transport", protocol = tls.SslProtocol.ToString(), cipher = tls.NegotiatedCipherSuite.ToString() }));
+            return tls;
+        }
+        catch { await tls.DisposeAsync(); throw; }
+    }
+
+    public static void CreateCertificate(string directory)
+    {
+        Directory.CreateDirectory(directory);
+        using RSA key = RSA.Create(2048);
+        var request = new CertificateRequest("CN=localhost", key, HashAlgorithmName.SHA256, RSASignaturePadding.Pkcs1);
+        var san = new SubjectAlternativeNameBuilder(); san.AddDnsName("localhost");
+        request.CertificateExtensions.Add(san.Build());
+        request.CertificateExtensions.Add(new X509BasicConstraintsExtension(true, false, 0, true));
+        using var certificate = request.CreateSelfSigned(DateTimeOffset.UtcNow.AddMinutes(-1), DateTimeOffset.UtcNow.AddDays(2));
+        File.WriteAllBytes(Path.Combine(directory, "server.pfx"), certificate.Export(X509ContentType.Pfx));
+        File.WriteAllBytes(Path.Combine(directory, "root.cer"), certificate.Export(X509ContentType.Cert));
+    }
+}
